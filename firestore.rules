rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Yahia Sobeih Family chat room security rules
    match /yahia_messages/{messageId} {
      allow read, write: if true;
    }
    match /yahia_events/{eventId} {
      allow read, write: if true;
    }
    match /yahia_announcements/{announcementId} {
      allow read, write: if true;
    }
    match /yahia_memories/{memoryId} {
      allow read, write: if true;
    }
    match /yahia_members/{memberId} {
      allow read, write: if true;
    }
    match /yahia_roster/{docId} {
      allow read, write: if true;
    }
  }
}
